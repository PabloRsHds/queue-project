# RESOURCE
POSTGRES_URL=jdbc:postgresql://localhost:5432/your-database

# POSTGRES
POSTGRES_DB=your-database
POSTGRES_USER=your-username
POSTGRES_PASSWORD=your-password

# POSTGRES PORT
POSTGRES_PORT=5432

# BACK-END
BACKEND_URL=8080

# FRONT-END
FRONTEND_PORT=4200
FRONTEND_URL=http://localhost:4200

# ADM
ADM_1_EMAIL=adm-email
ADM_1_PASSWORD=adm-password
ADM_1_USERNAME=adm-username
ADM_1_NAME=adm-name
ADM_1_SURNAME=adm-surname

# KEYS
PUBLIC_KEY= aqui o valor da sua chave publica
PRIVATE_KEY= aqui o valor da sua chave privada